# Outbound / GTM Supabase (Postgres connection string; use the transaction pooler :6543 on Vercel)
GTM_SUPABASE_DB_URL=
# Jobs Duniya Supabase
JD_SUPABASE_DB_URL=
JD_SUPABASE_URL=
JD_SUPABASE_SERVICE_ROLE_KEY=
# Public Jobs Duniya site, used for "view on site" links
JD_SITE_URL=https://www.jobsduniya.ae
# Auth (Auth.js v5 + Google). Leave AUTH_GOOGLE_ID empty to run locally without login.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAIL_DOMAIN=whitecarrot.io
# HubSpot private app token (companies + contacts read). HubSpot is the main record for Data space.
HUBSPOT_ACCESS_TOKEN=
# Optional: HubSpot portal id for "Open in HubSpot" links (looked up automatically if the token allows)
HUBSPOT_PORTAL_ID=
# Instantly API v2 key (read scopes: campaigns, analytics, accounts)
INSTANTLY_API_KEY=
